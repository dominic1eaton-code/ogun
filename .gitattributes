# ──────────────────────────────────────────────
# linux  (LF line endings)
# ──────────────────────────────────────────────
*.h         eol=lf
*.hpp       eol=lf
*.c         eol=lf
*.cc        eol=lf
*.cpp       eol=lf
*.cxx       eol=lf
*.py        eol=lf
*.pl        eol=lf
*.sh        eol=lf
