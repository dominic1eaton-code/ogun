*.applescript eol=lf
*.d         eol=lf
*.oya       eol=lf
*.jaku      eol=lf
*.bula      eol=lf
*.pro       eol=lf

# ──────────────────────────────────────────────
# windows  (CRLF line endings)
# ──────────────────────────────────────────────
*.bat       eol=crlf
*.cmd       eol=crlf
*.ps1       eol=crlf
